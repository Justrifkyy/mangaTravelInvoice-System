# ==============================================================================
# Database MySQL Lokal (XAMPP)
# ==============================================================================
# Salin file ini menjadi `.env` saat XAMPP MySQL sudah dinyalakan, lalu jalankan:
#   npm run db:push
#   npm run db:seed
#
# Jika DATABASE_URL belum diisi, aplikasi otomatis berjalan menggunakan
# penyimpanan lokal (.data/local-db.json) sehingga semua fitur tetap dapat diuji.
DATABASE_URL="mysql://root:@localhost:3306/manga_travel"

# Timezone tampilan aplikasi (default: Asia/Jakarta)
NEXT_PUBLIC_APP_TIMEZONE="Asia/Jakarta"

# Secret tanda tangan sesi cookie httpOnly (ganti di produksi, min. 32 karakter)
SESSION_SECRET="manga-travel-dev-session-secret-change-in-production-2026"
